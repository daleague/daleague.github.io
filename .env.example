# Non-secret configuration only. Never put a Yahoo client secret or refresh
# token in this file, or in any file committed to the repo. Those belong in
# GitHub Actions repository secrets — see README.md > "Connecting Yahoo Fantasy".

# --- Frontend (safe to expose to the browser; must be prefixed VITE_) ---
# Local dev defaults to true so you can build the UI without ever touching
# the Yahoo API. The CI build sets this to "false" once real data exists.
VITE_USE_MOCK_DATA=true

# --- Ingestion scripts only (read on the Node/CI side, never shipped to the browser) ---
YAHOO_LEAGUE_ID=your_league_id
YAHOO_GAME_ID=nfl
YAHOO_SEASON=2026
